# Placeholders only. Run the Windows setup to create independent local credentials.
DATABASE_URL="mysql://APP_USER:APP_PASSWORD@127.0.0.1:3307/moointer_dev"
TEST_DATABASE_URL="mysql://TEST_USER:TEST_PASSWORD@127.0.0.1:3307/moointer_test"
# Optional operator-only migration account; never use this identity for web requests.
# MIGRATION_DATABASE_URL="mysql://MIGRATION_USER:MIGRATION_PASSWORD@127.0.0.1:3307/moointer_dev"
# local = loopback origin only (development). production = HTTPS origin on a real host name (D227). No other value starts.
APP_ENV=local
BETTER_AUTH_URL=http://127.0.0.1:3010
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Private consignment attachments (outside public/.next/src/app). Default .local/uploads.
# UPLOAD_DIR=.local/uploads
# Proposed cutoff lead before loading start (or departure if loading is unknown), minutes 0-1440.
# CONSIGNMENT_CUTOFF_LEAD_MINUTES=0
# Connection pool size per application process (1-50). Default 5; tune from measured load.
# DATABASE_POOL_SIZE=5
# Production only: header written by the host's web server, used to count sign-in attempts per client.
# TRUSTED_PROXY_HEADER=x-forwarded-for
# TRUSTED_PROXY_HOPS=1
