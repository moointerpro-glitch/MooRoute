generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "mysql"
}

enum ScopeKind {
 GLOBAL
 BRANCH
 DEPARTMENT
 WAREHOUSE
}

enum DestinationType {
 BRANCH
 DC
 FACTORY
}

enum RevisionStatus {
 DRAFT
 PUBLISHED
 SUPERSEDED
}

enum TripKind {
 BRANCH_DELIVERY
 INBOUND_DC
 OTHER
}

enum ReceiptMode {
 PACKAGES
 DETAILED
}

enum ConsignmentStatus {
 DRAFT
 PENDING_REVIEW
 REJECTED
 ASSIGNED
 WAREHOUSE_RECEIVED
 LOADED
 IN_TRANSIT
 PARTIALLY_RECEIVED
 ISSUE
 RECEIVED
 CLOSED
 CANCELLED
 RETURNED
}

enum CustodyState {
 SENDER
 WAREHOUSE
 VEHICLE
 BRANCH
 RETURNED
}

enum EventKind {
 SUBMITTED
 ASSIGNED
 WAREHOUSE_RECEIVED
 LOADED
 DEPARTED
 RECEIPT
 ISSUE
 CORRECTION
 RETURNED
 CLOSED
 CANCELLED
}

enum ImportStatus {
 STAGED
 VALIDATED
 COMMITTED
 REJECTED
}

model User {
  id String @id @default(uuid()) @db.VarChar(36)
  createdAt DateTime @default(now()) @db.DateTime(3)
  subject String @unique @db.VarChar(191)
  displayName String @db.VarChar(191)
  active Boolean @default(true)
  version Int @default(1)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  userRole_userId UserRole[] @relation("UserRole_userId")
  userScope_userId UserScope[] @relation("UserScope_userId")
  routeRevision_createdById RouteRevision[] @relation("RouteRevision_createdById")
  templateRevision_createdById TemplateRevision[] @relation("TemplateRevision_createdById")
  planRevision_createdById PlanRevision[] @relation("PlanRevision_createdById")
  planRevision_publishedById PlanRevision[] @relation("PlanRevision_publishedById")
  consignment_requesterId Consignment[] @relation("Consignment_requesterId")
  addressSnapshot_createdById AddressSnapshot[] @relation("AddressSnapshot_createdById")
  consignmentAssignment_approvedById ConsignmentAssignment[] @relation("ConsignmentAssignment_approvedById")
  idempotencyRecord_actorId IdempotencyRecord[] @relation("IdempotencyRecord_actorId")
  consignmentEvent_actorId ConsignmentEvent[] @relation("ConsignmentEvent_actorId")
  attachment_uploaderId Attachment[] @relation("Attachment_uploaderId")
  printEvent_actorId PrintEvent[] @relation("PrintEvent_actorId")
  importBatch_createdById ImportBatch[] @relation("ImportBatch_createdById")
  auditLog_actorId AuditLog[] @relation("AuditLog_actorId")
}

